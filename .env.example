# ======================================================
# EstoquePro — Variaveis de Ambiente
# Copie para .env e preencha os valores reais:
#   cp .env.example .env
# ======================================================

# URL publica do servidor.
# Deploy final recomendado:
APP_BASE_URL=https://estoque.suaempresa.com.br

# Senha de acesso as paginas administrativas do sistema.
# Use uma senha forte, preferencialmente gerada por: openssl rand -base64 32
ADMIN_PASSWORD=sua_senha_forte_aqui

# ======================================================
# Meta WhatsApp Cloud API
# Opcional — deixe vazio se ainda nao for usar notificacoes.
# ======================================================
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Nomes dos templates aprovados no Meta Business
WA_TEMPLATE_NAME=form_solicitacoes_materiais
WA_TEMPLATE_LEMBRETE=lembrete_solicitacao_materiais
WA_TEMPLATE_PRAZO=aviso_prazo_solicitacao
WA_TEMPLATE_ENCERRAM=encerramento_ciclo_materiais
WA_TEMPLATE_FEEDBACK=feedback_solicitacao_materiais

WA_TEMPLATE_LANG=pt_BR

# ======================================================
# ntfy — push notifications internas ao responsável de estoque
# ======================================================

NTFY_SERVER=http://ntfy:port
NTFY_TOPIC=topico_ntfy
NTFY_TOKEN=tk_sua_chave_aqui
